// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         String   @default("Owner") // Owner, Employee (for future employee logins)
  position     String? // free-text job title, e.g. "Sales Executive" (Employee only)
  accessStart  String? // "HH:MM" 24h, in Asia/Kolkata — Employee login/session allowed from this time
  accessEnd    String? // "HH:MM" 24h, in Asia/Kolkata — Employee login/session allowed until this time
  attendanceEnabled Boolean @default(true) // whether geo-attendance check-in/out is required for this Employee
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignedLeads     Lead[]              @relation("LeadAssignee")
  attendanceLocations AttendanceLocation[]
  attendance        Attendance[]
}

model AttendanceLocation {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label        String // e.g. "Office", "Site A"
  latitude     Float
  longitude    Float
  radiusMeters Int      @default(200)
  createdAt    DateTime @default(now())

  @@index([userId])
}

model Attendance {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date              String // yyyy-mm-dd, Asia/Kolkata — one row per user per day
  checkInAt         DateTime?
  checkInLat        Float?
  checkInLng        Float?
  checkInLocation   String? // matched AttendanceLocation label at check-in time
  checkOutAt        DateTime?
  checkOutLat       Float?
  checkOutLng       Float?
  status            String    @default("Incomplete") // Incomplete, Full Day, Half Day, Absent
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([userId, date])
  @@index([userId])
}

model AttendanceSettings {
  id            String @id @default("default")
  fullDayHours  Float  @default(8)
  halfDayHours  Float  @default(4)
}

model Lead {
  id        String   @id @default(cuid())
  name      String
  phone     String
  interest  String? // free-text notes; structured fields below are preferred going forward
  propertyType      String?
  budgetRange       String?
  preferredLocation String?
  stage     String   @default("Lead") // Lead, First Call, Follow-up Call, Qualification, Consultation, Site Visit Scheduled, Site Visit Done, Negotiation, Booked, Registration, Closed
  status    String   @default("Open") // Open, On Hold, Won, Lost
  lossReason String? // set when status = Lost: Disqualified, Rejected, Budget Mismatch, Not Interested, No Response, Lost to Competitor, Other
  source    String?
  notes     String?
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  assignedToId String?
  assignedTo   User?   @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contactId])
  @@index([assignedToId])
}

// --- Contact-centric model ---

model Contact {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  types     String[] // Buyer, Builder, Vendor, Seller, Broker (multi-select)
  company   String?
  tags      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  buyerDetails    BuyerDetails?
  builderDetails  BuilderDetails?
  brokerDetails   BrokerDetails?
  vendorDetails   VendorDetails?
  sellerDetails   SellerDetails?
  interactions    Interaction[]
  leads           Lead[]
  tasks           Task[]
  builderProjects Project[] @relation("ProjectBuilder")
}

model BuyerDetails {
  contactId         String    @id
  contact           Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  budget            String?
  preferredLocation String?
  needs             String?
  status            String    @default("Looking")
  nextFollowUp      DateTime?
}

model BuilderDetails {
  contactId           String    @id
  contact             Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  projects            String?
  commissionStructure String?
  lastVisited         DateTime?
  nextVisit           DateTime?
  brochureLink        String?
}

model BrokerDetails {
  contactId       String  @id
  contact         Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  agencyName      String?
  commissionSplit String?
  status          String  @default("Active") // Active, Inactive, Dormant
}

model VendorDetails {
  contactId   String  @id
  contact     Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  serviceType String?
  rateCardRef String?
  status      String  @default("Active")
}

model SellerDetails {
  contactId   String  @id
  contact     Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  propertyRef String?
  askingPrice String?
  status      String  @default("Active")
}

model Interaction {
  id        String   @id @default(cuid())
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  type      String // Call, WhatsApp, Meeting, Email, Site Visit, Note, Document Shared, Stage Change, Deal Update
  content   String
  createdBy String?
  createdAt DateTime @default(now())

  @@index([contactId])
}

model Buyer {
  id                  String    @id @default(cuid())
  name                String
  budget              String?
  location            String?
  needs               String?
  status              String    @default("Looking")
  lastContact         DateTime?
  nextFollowUp        DateTime?
  interestedProjects  String? // comma-separated project names/ids, simple free text
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model Builder {
  id            String    @id @default(cuid())
  name          String
  contact       String?
  projects      String?
  commission    String?
  lastVisited   DateTime?
  nextVisit     DateTime?
  brochureLink  String?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Project {
  id             String   @id @default(cuid())
  name           String
  builder        String? // legacy free-text builder name, kept as fallback
  builderId      String?
  builderContact Contact? @relation("ProjectBuilder", fields: [builderId], references: [id], onDelete: SetNull)
  price          String?
  photo          String? // base64 data URL, compressed client-side
  brochureLink   String?
  floorPlanLink  String?
  amenities      String?
  nearby         String?
  commission     String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  events Event[]

  @@index([builderId])
}

model Event {
  id        String   @id @default(cuid())
  title     String
  type      String   @default("Meeting") // Call, Meeting, Site Visit, Builder Meeting
  date      String // yyyy-mm-dd
  time      String?
  projectId String? // set when type = Site Visit, links to the property being visited
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([projectId])
}

model Task {
  id        String    @id @default(cuid())
  title     String
  dueDate   DateTime?
  status    String    @default("pending") // pending, done, snoozed
  contactId String?
  contact   Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  createdAt DateTime  @default(now())

  recurrenceFreq          String  @default("none") // none, daily, weekly, monthly
  recurrenceInterval      Int     @default(1)
  recurringUntilCancelled Boolean @default(false)

  @@index([contactId])
}

model Note {
  id        String   @id @default(cuid())
  type      String   @default("Meeting") // Meeting, Builder, Buyer
  relatedTo String?
  text      String
  createdAt DateTime @default(now())
}

model Document {
  id        String   @id @default(cuid())
  name      String
  type      String   @default("Brochure")
  link      String
  createdAt DateTime @default(now())
}
